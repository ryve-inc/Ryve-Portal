# Database Connection (Neon Serverless PostgreSQL)
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-random-name.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Better Auth Configuration (32+ character random secret)
BETTER_AUTH_SECRET=ryve_sec_e8b417c8096f264d95a14032d887a419c836997230b4d47fbff2ad0964db2a99
BETTER_AUTH_URL=http://localhost:3000

# Ryve Storage Node Daemon Connection (Headless P2P Node)
# In local dev: http://localhost:7890 (or http://localhost:3001)
# In Vercel / Production: https://<your-aws-ip-or-domain>:7890
RYVE_NODE_URL=http://localhost:7890

# Ryve Node API Key (Bearer token for AWS daemon)
# Leave empty or set to any dummy string for local testing.
# Set to your AWS secret key in Vercel environment variables for production.
RYVE_NODE_API_KEY=
